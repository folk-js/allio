{
  "name": "allio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "RUST_LOG=allio=warn tauri dev",
    "dev:debug": "RUST_LOG=allio=debug tauri dev",
    "build": "tsc && vite build",
    "check": "cargo check",
    "docs": "cargo doc -p allio --no-deps --open",
    "typegen": "rm -rf packages/allio-client/src/types/generated && cargo test -p allio -p allio-ws -p allio-shader export_bindings"
  },
  "dependencies": {
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
